BOT_NAME=Hikari
WHATSAPP_OWNER_NUMBERS=5500000000000
WHATSAPP_NOTIFY_OWNER=false
WHATSAPP_AUTH_DIR=.whatsapp-auth
WHATSAPP_DATA_DIR=src/data/zap
WHATSAPP_MAX_MEDIA_MB=16
SAVE_HISTORY=true

LOG_DIR=logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_MAX_FILE_MB=5

SYSTEM_PROMPT="Você é Hikari, criada por Guilhermy. Converse naturalmente em português brasileiro pelo WhatsApp, sem emojis, emoticons ou kaomojis. Use ferramentas quando necessário sem exigir comandos. Considere apenas o contexto fornecido das últimas 15 mensagens do chat. Não invente resultados nem exponha dados privados."

GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK_2=gemini-3.8-flash
GEMINI_MODEL_FALLBACK_3=gemini-3.7-flash
HF_TOKEN=
HF_MODEL=Qwen/Qwen3.8-27B
HF_API_URL=https://router.huggingface.co/v1/chat/completions
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=local-model
LMSTUDIO_API_KEY=
LLM_TIMEOUT_MS=30000
POLLINATIONS_API_KEY=
POLLINATIONS_TEXT_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai

BRAVE_API_KEY=
HORDE_IMAGE_API_KEY=0000000000

CURRENCY_PROVIDER=awesomeapi
AWESOMEAPI_KEY=

GROQ_API_KEY=
WITAI_TOKEN=
OPENAI_STT_KEY=
OPENAI_STT_URL=https://api.openai.com/v1/audio/transcriptions
HF_STT_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3-turbo
LOCAL_STT_URL=

MODAL_TTS_ENDPOINT=
HF_TTS_ENDPOINT=
VOICE_SPEED=1.15
VOICE_TEMPERATURE=0.65
VOICE_MAX_CHARS=1000

FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
PYTHON_PATH=
YTDLP_COOKIES_PATH=
DEEZER_ARL=

# Disponibilidade de modelos e controle da fila
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
HF_MODELS=Qwen/Qwen3.8-27B,openai/gpt-oss-20b,meta-llama/Llama-3.1-8B-Instruct
GROQ_CHAT_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
AI_PROVIDER_ORDER=groq,gemini,huggingface,pollinations
ALLOW_PUBLIC_POLLINATIONS=false
LLM_ATTEMPT_TIMEOUT_MS=10000
LLM_COMPLETION_BUDGET_MS=35000
LLM_AGENT_BUDGET_MS=90000
LLM_MAX_ATTEMPTS=8
LLM_MAX_PROVIDER_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=2048
QUEUE_CONCURRENCY=2
QUEUE_MAX_PENDING=20
QUEUE_MAX_PER_CHAT=4
QUEUE_WAIT_TIMEOUT_MS=60000
QUEUE_TASK_TIMEOUT_MS=180000

GROQ_CHAT_ENABLED=false
